# ── Database (Zerops PostgreSQL) ──────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/zeropulse"

# ── Cache / Queue (Zerops Valkey) ─────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Email alerts (Resend - free tier) ─────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxx"

# ── App URL (your Zerops public domain) ───────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://your-app.zerops.app"
